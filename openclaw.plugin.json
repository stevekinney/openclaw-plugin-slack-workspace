{
  "id": "slack-workspace",
  "name": "Slack Workspace",
  "description": "Slack workspace tools: identity and message scheduling, search, structured messaging (tables, plans, charts, rich text), raw Block Kit messages, canvases, channel bookmarks, public-channel lifecycle (create, archive, rename, topic, purpose, invite, join, leave, one-call kickoff), Slack Lists, file uploads, Workflow Builder webhook triggers, and read-only user group lookups.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "botToken": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          }
        ],
        "description": "Slack bot token (xoxb-) or a SecretRef ({source,provider,id}). Falls back to SLACK_BOT_TOKEN."
      },
      "userToken": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          }
        ],
        "description": "Slack user token (xoxp-) or a SecretRef. Required by search, which rejects bot tokens. Falls back to SLACK_USER_TOKEN."
      },
      "workflowTriggers": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "source",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "description": "Workflow Builder webhook trigger URLs (https://hooks.slack.com/triggers/...) by name, each a string or a SecretRef, e.g. {\"standup\": {source,provider,id}}. The URL is the credential; slack_workflow_trigger_run starts a workflow by name."
      },
      "autoJoin": {
        "type": "boolean",
        "description": "When a bot-token call fails with not_in_channel on a public channel, join it once and retry. Default true."
      },
      "autoJoinDeny": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Channel IDs the bot must never auto-join, e.g. [\"C0123ABCD\"]."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "cliCommands": [
    {
      "name": "slack-workspace",
      "description": "Slack Workspace plugin utilities",
      "hasSubcommands": true
    }
  ],
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "botToken",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "userToken",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "workflowTriggers.*",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
