+import { afterEach, describe, expect, it } from "vitest";
+import { initializeGlobalHookRunner, resetGlobalHookRunner } from "./hook-runner-global.js";
+import { createHookRunner } from "./hooks.js";
+import { addTestHook } from "./hooks.test-helpers.js";
+import { createEmptyPluginRegistry } from "./registry.js";
+import { getActivePluginRegistry, setActivePluginRegistry } from "./runtime.js";
+import { withPluginRuntimeGenerationRegistryScope } from "./runtime/generation-state.js";
+import { createRuntimeChannel } from "./runtime/runtime-channel.js";
+import type {
+  PluginHookResolveInboundRouteEvent,
+  PluginHookResolveInboundRouteResult,
+  PluginHookRegistration,
+} from "./types.js";
+
+const event: PluginHookResolveInboundRouteEvent = {
+  channel: "slack",
+  accountId: "default",
+  workspaceId: "T1",
+  conversationId: "C1",
+  senderId: "U1",
+  messageId: "M1",
+  content: "hello",
+  isDirect: false,
+  agentId: "main",
+  sessionKey: "agent:main:slack:channel:C1",
+};
+
+describe("resolve_inbound_route hook", () => {
+  const originalRegistry = getActivePluginRegistry();
+  afterEach(() => {
+    resetGlobalHookRunner();
+    setActivePluginRegistry(originalRegistry);
+  });
+
+  it("reads published routing rules after a listener retains an older generation", async () => {
+    const listenerRegistry = createEmptyPluginRegistry();
+    const channel = createRuntimeChannel();
+    const resolve = () =>
+      withPluginRuntimeGenerationRegistryScope(listenerRegistry, () =>
+        channel.routing.resolveInboundRoute(event),
+      );
+    for (const sessionId of ["first-publication", "second-publication"]) {
+      const published = createEmptyPluginRegistry();
+      const result = {
+        agentId: "support",
+        sessionKey: "agent:support:verification",
+        expectedSessionId: sessionId,
+      };
+      addTestHook({
+        registry: published,
+        pluginId: "slack-router",
+        hookName: "resolve_inbound_route",
+        handler: (() => result) as PluginHookRegistration["handler"],
+      });
+      setActivePluginRegistry(published);
+      initializeGlobalHookRunner(published);
+      await expect(resolve()).resolves.toEqual(result);
+    }
+  });
+
+  it("returns the first concrete route and preserves its session identity", async () => {
+    const registry = createEmptyPluginRegistry();
+    const result: PluginHookResolveInboundRouteResult = {
+      agentId: "support",
+      sessionKey: "agent:support:slack:channel:C1",
+      expectedSessionId: "session-1",
+      reason: "workspace policy",
+    };
+    addTestHook({
+      registry,
+      pluginId: "slack-router",
+      hookName: "resolve_inbound_route",
+      handler: (() => result) as PluginHookRegistration["handler"],
+    });
+
+    await expect(createHookRunner(registry).runResolveInboundRoute(event, event)).resolves.toEqual(
+      result,
+    );
+  });
+});
