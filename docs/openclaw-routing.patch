+import { afterEach, describe, expect, it } from "vitest";
+import {
+  getSlackInstallationWorkspaceId,
+  registerSlackInstallationState,
+} from "./installation-identity-state.js";
+
+const accountId = `identity-test-${Math.random().toString(36).slice(2)}`;
+
+describe("Slack installation identity workspace provenance", () => {
+  const registrations: Array<{ release: () => void }> = [];
+
+  afterEach(() => {
+    for (const registration of registrations.splice(0)) {
+      registration.release();
+    }
+  });
+
+  it("retains workspace team identity and clears it for enterprise updates", () => {
+    const registration = registerSlackInstallationState(accountId, "workspace", "T123");
+    registrations.push(registration);
+    expect(getSlackInstallationWorkspaceId(accountId)).toBe("T123");
+
+    registration.update("enterprise");
+    expect(getSlackInstallationWorkspaceId(accountId)).toBeUndefined();
+  });
+
+  it("does not let a released owner remove a replacement registration", () => {
+    const first = registerSlackInstallationState(accountId, "workspace", "T111");
+    const second = registerSlackInstallationState(accountId, "workspace", "T222");
+    registrations.push(second);
+
+    first.release();
+    expect(getSlackInstallationWorkspaceId(accountId)).toBe("T222");
+  });
+});
