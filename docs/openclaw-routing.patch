@@ -0,0 +1,57 @@
+import type { PluginRuntime } from "openclaw/plugin-sdk/channel-core";
+import type { SlackMonitorContext } from "../context.js";
+
+type RoutingRuntime = Pick<
+  PluginRuntime["channel"]["routing"],
+  "inboundRouteContractVersion" | "resolveInboundRoute"
+>;
+type RouteEvent = Parameters<RoutingRuntime["resolveInboundRoute"]>[0];
+
+export type SlackInteractionRoute = {
+  agentId: string;
+  sessionKey: string;
+  expectedSessionId?: string;
+};
+
+export async function resolveSlackInteractionRoute(params: {
+  ctx: SlackMonitorContext;
+  fallback: SlackInteractionRoute;
+  event: RouteEvent;
+}): Promise<SlackInteractionRoute | null> {
+  const routing = (params.ctx.channelRuntime as PluginRuntime["channel"] | undefined)?.routing as
+    | RoutingRuntime
+    | undefined;
+  if (routing?.inboundRouteContractVersion !== 1) {
+    return params.fallback;
+  }
+  const result = await routing.resolveInboundRoute(params.event);
+  if (!result) {
+    return params.fallback;
+  }
+  if ("drop" in result) {
+    return null;
+  }
+  return {
+    agentId: result.agentId,
+    sessionKey: result.sessionKey,
+    expectedSessionId: result.expectedSessionId,
+  } satisfies SlackInteractionRoute;
+}
+
+export function interactionRouteEvent(params: {
+  accountId: string;
+  workspaceId: string;
+  conversationId: string;
+  senderId: string;
+  messageId: string;
+  content: string;
+  isDirect: boolean;
+  agentId: string;
+  sessionKey: string;
+  threadId?: string;
+  replyToId?: string;
+  interaction?: NonNullable<RouteEvent["interaction"]>;
+  signal?: AbortSignal;
+}): RouteEvent {
+  return { ...params, channel: "slack" };
+}
