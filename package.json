{
  "name": "@stevekinney/openclaw-slack-workspace",
  "version": "0.2.0",
  "description": "OpenClaw plugin with Slack workspace tools the bundled Slack channel plugin lacks: scheduling, search, structured messages, canvases, bookmarks, channel management, Slack Lists, files, and Workflow Builder triggers.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "slack",
    "block-kit",
    "canvases",
    "slack-lists"
  ],
  "license": "MIT",
  "author": "Steve Kinney",
  "homepage": "https://github.com/stevekinney/openclaw-plugin-slack-workspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/openclaw-plugin-slack-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/stevekinney/openclaw-plugin-slack-workspace/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:check": "npm run build && openclaw plugins build --check --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "test:artifact": "node scripts/test-artifact.ts",
    "ci": "npm run typecheck && npm run plugin:check && openclaw plugins validate --entry ./dist/index.js && npm test",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "docs/routing.md",
    "docs/openclaw-routing.patch",
    "CHANGELOG.md",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "2026.10.6",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "npm": "12.2.1",
    "undici@8": "8.12.3",
    "zod": "4.6.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.6",
      "pluginSdkVersion": "2026.10.6"
    }
  }
}
